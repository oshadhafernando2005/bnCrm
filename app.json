{
  "expo": {
    "name": "File My Tax",
    "slug": "BriscaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/newIcon.jpg",
    "scheme": "briscaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oshadha2005.BriscaApp",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adpicon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.oshadha2005.BriscaApp",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/newIcon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/newIcon.jpg",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#062041",
          "dark": {
            "backgroundColor": "#062041"
          }
        }
      ],
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c10d2e3-3fc7-4295-842d-b55990027fd2"
      }
    },
    "owner": "briscatax2015"
  }
}
